>   const toggleRole = (role: string) => {
>     setError('');
>     if (isUpgradeMode && role === 'FAN') return;
> 
>     setActiveUserRoles(prev => {
>        if (role === 'FAN') {
>           if (prev.includes('FAN')) return [];
>           return ['FAN']; // Exclusive isolation
>        }
>        
>        let updated = prev.filter(r => r !== 'FAN'); // removing fan if we select another
>        if (updated.includes(role)) {
>           updated = updated.filter(r => r !== role);
>        } else {
>           updated = [...updated, role];
>        }
>        return updated;
>     });
>   };
