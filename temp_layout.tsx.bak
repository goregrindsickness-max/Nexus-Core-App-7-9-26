                        <div className="grid grid-cols-1 gap-1.5">
                          {[
                            { key: 'fan', icon: '🎟️', name: 'Fan Portal', desc: 'Social environment', bgClass: 'bg-rose-950/10 text-rose-300 border-rose-950/40', allowed: true },
                            { key: 'band', icon: '🎸', name: 'Artist Workspace', desc: 'Lineup & repertoire', bgClass: 'bg-emerald-950/10 text-emerald-300 border-emerald-950/40', allowed: allowedWorkspaces.includes('band') },
                            { key: 'promoter', icon: '🏟️', name: 'Promoter Gateway', desc: 'Calendars & finance', bgClass: 'bg-purple-950/10 text-purple-300 border-purple-950/40', allowed: allowedWorkspaces.includes('promoter') },
                            { key: 'creative', icon: '🛠️', name: 'Creative Hub', desc: 'Contracts & portfolio', bgClass: 'bg-violet-950/10 text-violet-305 border-violet-950/40', allowed: allowedWorkspaces.includes('creative') },
                          ].map((role) => {
                            if (!role.allowed) return null;
                            return (
                              <button
                                key={role.key}
                                type="button"
                                onClick={() => {
                                  setV2RoleMenuOpen(false);
                                  setUserProfile({ ...userProfile, account_type: role.key as any });
