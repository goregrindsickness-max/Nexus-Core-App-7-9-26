                  <Globe className="w-4 h-4 text-orange-500" />
                )}
              </button>

              <AnimatePresence>
                {v2RoleMenuOpen && (
                  <>
                    <div className="fixed inset-0 z-40 bg-black/40 backdrop-blur-[1px]" onClick={() => setV2RoleMenuOpen(false)} />
