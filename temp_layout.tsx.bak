                                <div className="flex items-center gap-2 min-w-0">
                                  <span className="text-sm shrink-0">{role.icon}</span>
                                  <div className="min-w-0">
                                    <span className="block font-black text-[9px] uppercase tracking-wider">{role.name}</span>
                                    <span className="block text-[8px] text-zinc-500 truncate lowercase">{role.desc}</span>
                                  </div>
                                </div>
                                <ChevronDown className="w-3.5 h-3.5 -rotate-90 opacity-30 group-hover:opacity-100 shrink-0" />
                              </button>
